{
  "meta": {
    "name": "Data Bus",
    "category": "basic",
    "description": "Address + data bus with valid signal pattern",
    "tags": ["data", "bus", "addr", "valid", "basic"]
  },
  "signal": [
    { "name": "clk",     "wave": "p........" },
    {},
    { "name": "valid",   "wave": "0.1...0.." },
