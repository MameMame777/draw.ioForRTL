    { "name": "wdata",   "wave": "x.=.=.x..", "data": ["D0","D1"] },
    { "name": "rdata",   "wave": "x...=.=..", "data": ["R0","R1"] },
    { "name": "ready",   "wave": "1........." }
  ],
  "config": { "hscale": 1 },
  "head": { "text": "Data Bus Transfer", "tick": 0 }
}
